---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import PressMentions from "@/components/business/PressMentions.astro";
import { BUSINESS_DATA } from "@/data/business";
import { CANONICAL_IDS } from "@/lib/seo/schema";

const title = `Sobre Nós - Desde ${BUSINESS_DATA.foundingYear} em Tijucas | Estúdio Evydência`;
const description = `Conheça a história dos fundadores Anderson e Elaine e a trajetória do Estúdio Evydência desde ${BUSINESS_DATA.foundingYear} em Tijucas - SC.`;

const timeline = [
  {
    year: "2011",
    title: "Fundação do Estúdio em Tijucas",
    text: "Anderson e Elaine iniciam a jornada da Evydência Fotografia, dedicando-se a registrar celebrações e histórias de famílias."
  },
  {
    year: "2015",
    title: "Especialização em Gestantes e Primeira Infância",
    text: "Criação de cenários dedicados ao acompanhamento de bebês e ensaios Smash the Cake em ambiente climatizado."
  },
  {
    year: "2020",
    title: "Consolidação da Estrutura no Bairro Universitário",
    text: "Estruturação do estúdio na Rua Mauri Afonso da Silva, com ambiente privativo e modificadores de luz para controle refinado de direção, contraste e suavidade."
  },
  {
    year: "Hoje",
    title: `Desde ${BUSINESS_DATA.foundingYear} Criando Memórias Afetivas`,
    text: "Milhares de famílias e clientes fotografados com reconhecimento contínuo em Tijucas e no litoral catarinense."
  }
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://evydencia.com.br/sobre/#webpage",
      "url": "https://evydencia.com.br/sobre/",
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": CANONICAL_IDS.website
      },
      "about": {
        "@id": CANONICAL_IDS.business
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://evydencia.com.br/sobre/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://evydencia.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Sobre Nós",
          "item": "https://evydencia.com.br/sobre/"
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={aboutSchema}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Nossa História
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Quem Somos: Anderson e Elaine
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Desde {BUSINESS_DATA.foundingYear} dedicados a registrar momentos únicos e eternizar o amor de famílias em Tijucas e Santa Catarina.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Fotos dos Fundadores -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="rounded-2xl overflow-hidden shadow-md aspect-[3/4] bg-gray-100 relative group">
          <img
            src="https://evydencia.com.br/imgs/anderson.jpg"
            alt="Anderson, fotógrafo e fundador do Estúdio Evydência"
            width="400"
            height="533"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
            loading="eager"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 to-transparent p-6 text-white">
            <p class="font-bold text-lg font-serif-brand">Anderson</p>
            <p class="text-xs text-brand-gold-light">Fotógrafo Fundador & Especialista em Iluminação</p>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md aspect-[3/4] bg-gray-100 relative group">
          <img
            src="https://evydencia.com.br/imgs/elaine.jpg"
            alt="Elaine, fotógrafa e fundadora do Estúdio Evydência"
            width="400"
            height="533"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
            loading="eager"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 to-transparent p-6 text-white">
            <p class="font-bold text-lg font-serif-brand">Elaine</p>
            <p class="text-xs text-brand-gold-light">Fotógrafa Fundadora & Direção de Famílias</p>
          </div>
        </div>
      </div>

      <!-- Texto Institucional com Prova de Entidade -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
          A Paixão por Contar Histórias em Imagens
        </h2>
        <p>
          O <strong>Estúdio Evydência</strong> foi fundado em Tijucas no ano de 2011 pelo casal Anderson e Elaine. O que começou como uma vocação para registrar momentos familiares evoluiu para um dos estúdios mais reconhecidos do Vale do Rio Tijucas e da Costa Esmeralda.
        </p>
        <p>
          Nossa abordagem une o rigor técnico de iluminação e composição com uma atmosfera acolhedora e intimista. Acreditamos que um grande retrato nasce da conexão humana e do respeito ao tempo de cada pessoa — seja um bebê descobrindo o mundo, uma futura mãe na expectativa do nascimento ou uma família reunindo várias gerações.
        </p>
      </div>

      <!-- Linha do Tempo Factual -->
      <div class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
          Nossa Trajetória
        </h2>
        <div class="space-y-6 border-l-2 border-brand-gold/30 pl-6 ml-2">
          {timeline.map((item) => (
            <div class="relative space-y-1">
              <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-brand-gold border-2 border-white shadow-xs" />
              <span class="text-xs font-bold uppercase tracking-wider text-brand-gold-dark">{item.year}</span>
              <h3 class="text-lg font-bold text-gray-900 font-serif-brand">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Menções na Imprensa -->
      <PressMentions limit={2} />

      <WhatsAppCTA
        variant="banner"
        service="sobre"
        customTitle="Venha fazer parte da nossa história"
        customSubtitle="Fale diretamente com Anderson e Elaine pelo WhatsApp e agende seu ensaio em Tijucas."
        customMessage="Olá Anderson e Elaine! Vi a história do Estúdio Evydência e gostaria de agendar um ensaio com vocês."
      />

    </div>
  </section>
</BaseLayout>
