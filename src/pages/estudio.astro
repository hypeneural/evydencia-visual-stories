---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import PictureCard from "@/components/gallery/PictureCard.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { BUSINESS_DATA } from "@/data/business";

const title = "Conheça o Estúdio Evydência em Tijucas | Estrutura e Atendimento";
const description = `Conheça a estrutura do Estúdio Evydência na Rua Mauri Afonso da Silva em Tijucas - SC: ambiente climatizado, iluminação profissional controlada e atendimento com hora marcada.`;

const studioHighlights = [
  { src: "https://evydencia.com.br/imgs/GESTANTES.png", alt: "Área de fotografia com iluminação controlada no Estúdio Evydência em Tijucas", caption: "Área de Fotografia & Iluminação Suave" },
  { src: "https://evydencia.com.br/imgs/SMASH_THE_CAKE.png", alt: "Cenários fotográficos higienizados para bebês e famílias", caption: "Cenários Temáticos & Higienizados" },
  { src: "https://evydencia.com.br/imgs/ACOMPANHAMENO_MENSAL.png", alt: "Ambiente climatizado e confortável para bebês no bairro Universitário", caption: "Ambiente Climatizado & Conforto Térmico" }
];
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Espaço Físico
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Nosso Estúdio de Fotografia em Tijucas
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Um espaço acolhedor e privativo, planejado para oferecer conforto térmico, tranquilidade e precisão de iluminação durante sua sessão.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Pilares da Estrutura -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">❄️</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Ambiente Climatizado</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Temperatura e umidade controladas para garantir conforto total para gestantes, bebês e famílias em qualquer época do ano.
          </p>
        </div>

        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">🧼</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Higienização e Cuidado</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Cenários, pisos, mantas e acessórios rigorosamente higienizados antes e depois de cada atendimento individual.
          </p>
        </div>

        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">💡</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Iluminação Controlada</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Utilizamos flashes e modificadores de luz (como octaboxes e difusores de grande porte) para controlar direção, contraste e suavidade.
          </p>
        </div>
      </div>

      <!-- Destaques Visuais com PictureCard e Lightbox -->
      <div class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand text-center">
          Bastidores e Ambientes do Estúdio
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
          {studioHighlights.map((photo) => (
            <PictureCard
              src={photo.src}
              alt={photo.alt}
              caption={photo.caption}
              aspectRatio="square"
              enableZoom={true}
            />
          ))}
        </div>
      </div>

      <!-- Detalhamento dos Ambientes e Conforto -->
      <div class="space-y-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
          Estrutura Pensada para o Bem-Estar da Sua Família
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-6 bg-brand-beige/30 rounded-2xl border border-brand-gold/15 space-y-2">
            <h3 class="font-bold text-gray-900 font-serif-brand text-lg">Área Principal de Fotografia</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Espaço amplo com fundos infinitos neutros, iluminação modulada e piso antiderrapante para total segurança de crianças e idosos.
            </p>
          </div>

          <div class="p-6 bg-brand-beige/30 rounded-2xl border border-brand-gold/15 space-y-2">
            <h3 class="font-bold text-gray-900 font-serif-brand text-lg">Camarim e Troca de Looks</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Área privativa com espelho e cabides para organização tranquila de roupas, maquiagem e acessórios durante a sessão.
            </p>
          </div>

          <div class="p-6 bg-brand-beige/30 rounded-2xl border border-brand-gold/15 space-y-2">
            <h3 class="font-bold text-gray-900 font-serif-brand text-lg">Conforto para Mães e Bebês</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Espaço de apoio com trocador higienizado e ambiente calmo para pausas de amamentação e descanso da criança.
            </p>
          </div>

          <div class="p-6 bg-brand-beige/30 rounded-2xl border border-brand-gold/15 space-y-2">
            <h3 class="font-bold text-gray-900 font-serif-brand text-lg">Fácil Acesso e Estacionamento</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Rua tranquila no bairro Universitário com facilidade para estacionar em frente ao estúdio, trazendo praticidade no desembarque de carrinhos de bebê.
            </p>
          </div>
        </div>
      </div>

      <!-- Texto Institucional -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
          Atendimento Exclusivo com Hora Marcada
        </h2>
        <p>
          Localizado na <strong>{BUSINESS_DATA.address.street}</strong> no bairro {BUSINESS_DATA.address.neighborhood} em Tijucas - SC (CEP {BUSINESS_DATA.address.postalCode}), o Estúdio Evydência realiza atendimentos individuais por agendamento prévio.
        </p>
        <p>
          Isso assegura que o espaço seja 100% exclusivo para você e sua família durante todo o período do ensaio, sem pressa e com total privacidade.
        </p>
      </div>

      <WhatsAppCTA
        variant="banner"
        service="estudio"
        customTitle="Quer conhecer nosso espaço em Tijucas?"
        customSubtitle="Fale conosco no WhatsApp para tirar dúvidas sobre nossa estrutura ou agendar sua visita com hora marcada."
        customMessage="Olá! Gostaria de informações sobre a estrutura e disponibilidade de datas do Estúdio Evydência."
      />

    </div>
  </section>

  <StudioLocation />
</BaseLayout>
