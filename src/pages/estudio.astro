---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import PictureCard from "@/components/gallery/PictureCard.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { BUSINESS_DATA } from "@/data/business";

const title = "Conheça o Estúdio Evydência em Tijucas | Estrutura e Atendimento";
const description = `Conheça a estrutura do Estúdio Evydência na Rua Mauri Afonso da Silva em Tijucas - SC: ambiente climatizado, higienizado, iluminação profissional e atendimento com hora marcada.`;

const studioHighlights = [
  { src: "https://evydencia.com.br/imgs/GESTANTES.png", alt: "Ensaio fotográfico realizado com iluminação suave no Estúdio Evydência", caption: "Iluminação Suave & Direção de Poses" },
  { src: "https://evydencia.com.br/imgs/SMASH_THE_CAKE.png", alt: "Cenário temático para primeiro aniversário no Estúdio Evydência", caption: "Cenários Temáticos & Higienizados" },
  { src: "https://evydencia.com.br/imgs/ACOMPANHAMENO_MENSAL.png", alt: "Sessão de acompanhamento infantil em estúdio climatizado", caption: "Ambiente Climatizado para Bebês" }
];
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Espaço Físico
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Nosso Estúdio de Fotografia em Tijucas
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Um espaço acolhedor e seguro, planejado para oferecer conforto térmico, tranquilidade e privacidade durante sua sessão fotográfica.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Pilares da Estrutura -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">❄️</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Ambiente Climatizado</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Temperatura controlada para garantir conforto total para gestantes, bebês e famílias em qualquer época do ano.
          </p>
        </div>

        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">🧼</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Higienização e Cuidado</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Cenários, superfícies e acessórios rigorosamente higienizados antes e depois de cada sessão fotográfica.
          </p>
        </div>

        <div class="bg-brand-beige/50 p-8 rounded-2xl border border-brand-gold/15 space-y-3">
          <div class="text-3xl">💡</div>
          <h3 class="text-xl font-bold text-gray-900 font-serif-brand">Iluminação Profissional</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Equipamentos e modificadores de luz pensados para criar retratos suaves, artísticos e fiéis às cores naturais.
          </p>
        </div>
      </div>

      <!-- Destaques Visuais com PictureCard e Lightbox -->
      <div class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand text-center">
          Bastidores e Resultados das Sessões
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
          {studioHighlights.map((photo) => (
            <PictureCard
              src={photo.src}
              alt={photo.alt}
              caption={photo.caption}
              aspectRatio="square"
              enableZoom={true}
            />
          ))}
        </div>
      </div>

      <!-- Texto Institucional -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
          Atendimento Exclusivo com Hora Marcada
        </h2>
        <p>
          Localizado na <strong>{BUSINESS_DATA.address.street}</strong> no bairro {BUSINESS_DATA.address.neighborhood} em Tijucas - SC (CEP {BUSINESS_DATA.address.postalCode}), o Estúdio Evydência realiza atendimentos individuais por agendamento prévio.
        </p>
        <p>
          Isso assegura que o espaço seja 100% exclusivo para você e sua família durante todo o período do ensaio, sem pressa e com total privacidade para trocas de figurinos e momentos de descanso.
        </p>
      </div>

      <WhatsAppCTA variant="banner" />

    </div>
  </section>

  <StudioLocation />
</BaseLayout>
