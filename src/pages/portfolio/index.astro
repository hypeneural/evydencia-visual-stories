---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCollection } from "astro:content";

const title = "Portfólio de Fotografias em Tijucas | Estúdio Evydência";
const description = "Explore as galerias de ensaios de gestante, família, acompanhamento do bebê, smash the cake, casal, corporativo, eventos e Natal do Estúdio Evydência em Tijucas - SC.";

const portfolios = await getCollection("portfolio");

// Ordenação amigável por prioridade comercial
const categoryOrder = [
  "natal",
  "gestante",
  "familia",
  "bebe",
  "smash-the-cake",
  "infantil",
  "casal",
  "corporativo",
  "eventos"
];

const sortedPortfolios = [...portfolios].sort((a, b) => {
  const indexA = categoryOrder.indexOf(a.id);
  const indexB = categoryOrder.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Galeria de Trabalhos Autorais
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Portfólio de Ensaios Fotográficos
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Explore nossos registros divididos por categoria e conheça a sensibilidade e o padrão de iluminação do Estúdio Evydência.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPortfolios.map((item) => (
          <a
            href={`/portfolio/${item.id}/`}
            class="group block bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between"
          >
            <div>
              <div class="aspect-[16/10] bg-gray-100 overflow-hidden relative">
                <img
                  src={item.data.coverImage}
                  alt={item.data.title}
                  width="600"
                  height="375"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-5">
                  <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full ${
                    item.id === "natal" 
                      ? "text-amber-950 bg-amber-200 border border-amber-400/60" 
                      : "text-brand-gold-light bg-black/50 backdrop-blur-xs"
                  }`}>
                    {item.id === "natal" ? "🎄 " + item.data.category : item.data.category}
                  </span>
                </div>
              </div>
              
              <div class="p-6 space-y-2">
                <h2 class="text-xl font-bold text-gray-900 font-serif-brand group-hover:text-brand-gold transition-colors">
                  {item.data.title.includes("|") ? item.data.title.split("|")[0]?.trim() : item.data.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                  {item.data.description}
                </p>
              </div>
            </div>
            
            <div class="px-6 pb-6 pt-2">
              <div class="pt-4 border-t border-gray-100 flex items-center text-sm font-semibold text-brand-gold group-hover:text-brand-gold-dark">
                Ver Galeria Completa →
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16">
        <WhatsAppCTA 
          variant="banner"
          customTitle="Gostou do nosso portfólio?"
          customSubtitle="Fale diretamente conosco pelo WhatsApp. Tiramos todas as dúvidas sobre pacotes, datas disponíveis e figurinos."
        />
      </div>

    </div>
  </section>
</BaseLayout>
