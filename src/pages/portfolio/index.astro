---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCollection } from "astro:content";

const title = "Portfólio de Fotografias | Estúdio Evydência";
const description = "Explore as galerias de fotos de gestantes, famílias, acompanhamento de bebês e retratos corporativos do Estúdio Evydência em Tijucas - SC.";

const portfolios = await getCollection("portfolio");
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Galeria de Trabalhos
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Portfólio de Ensaios Fotográficos
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Conheça nossos trabalhos mais recentes divididos por categoria e inspire-se para a sua própria sessão.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {portfolios.map((item) => (
          <a
            href={`/portfolio/${item.id}/`}
            class="group block bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 border border-gray-100"
          >
            <div class="aspect-[16/9] bg-gray-100 overflow-hidden relative">
              <img
                src={item.data.coverImage}
                alt={item.data.title}
                width="600"
                height="338"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-gold-light bg-black/40 backdrop-blur-xs px-3 py-1 rounded-full">
                  {item.data.category}
                </span>
              </div>
            </div>
            
            <div class="p-6">
              <h2 class="text-xl font-bold text-gray-900 font-serif-brand group-hover:text-brand-gold transition-colors">
                {item.data.title}
              </h2>
              <p class="text-gray-600 text-sm mt-2 leading-relaxed">
                {item.data.description}
              </p>
              <div class="mt-4 pt-4 border-t border-gray-50 flex items-center text-sm font-semibold text-brand-gold">
                Ver Galeria Completa →
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16">
        <WhatsAppCTA variant="banner" />
      </div>

    </div>
  </section>
</BaseLayout>
