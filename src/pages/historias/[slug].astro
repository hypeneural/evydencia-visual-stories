---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PictureCard from "@/components/gallery/PictureCard.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { BUSINESS_DATA } from "@/data/business";

export async function getStaticPaths() {
  const stories = await getCollection("stories");
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story }
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

const currentPath = Astro.url.pathname;
const canonicalUrl = getCanonicalUrl(currentPath);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": story.data.h1,
  "description": story.data.description,
  "image": story.data.featuredImage,
  "datePublished": story.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Anderson e Elaine - Estúdio Evydência"
  },
  "publisher": {
    "@type": "Organization",
    "name": BUSINESS_DATA.name,
    "logo": {
      "@type": "ImageObject",
      "url": "https://evydencia.com.br/imgs/GESTANTES.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Início", url: "https://evydencia.com.br/" },
  { name: "Histórias", url: "https://evydencia.com.br/historias/" },
  { name: story.data.h1, url: canonicalUrl }
]);

const combinedSchema = [articleSchema, breadcrumbSchema];
---

<BaseLayout
  title={story.data.title}
  description={story.data.description}
  image={story.data.featuredImage}
  schema={combinedSchema}
>
  <article>
    <!-- Header do Case Study -->
    <header class="bg-gradient-to-b from-brand-beige via-brand-beige/50 to-white py-14 lg:py-20 border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-gold-dark bg-brand-gold/10 px-3 py-1 rounded-full">
            {story.data.sessionType}
          </span>
          <span class="text-xs text-gray-500 font-medium">
            📍 {story.data.location}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight font-serif-brand">
          {story.data.h1}
        </h1>

        <p class="text-lg text-gray-600 leading-relaxed pt-2">
          {story.data.description}
        </p>

      </div>
    </header>

    <!-- Conteúdo Principal -->
    <section class="py-14 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <!-- Imagem Principal de Abertura -->
        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100 aspect-[16/10] bg-gray-100 relative">
          <img
            src={story.data.featuredImage}
            alt={story.data.h1}
            width="800"
            height="500"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Conteúdo Editorial Markdown -->
        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
          <Content />
        </div>

        <!-- Galeria de Momentos Selecionados -->
        {story.data.gallery.length > 0 && (
          <div class="space-y-6 pt-4">
            <h2 class="text-2xl font-bold text-gray-900 font-serif-brand">
              Registros Selecionados Desta Sessão
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {story.data.gallery.map((photo) => (
                <PictureCard
                  src={photo.src}
                  alt={photo.alt}
                  caption={photo.caption}
                  aspectRatio="square"
                  enableZoom={true}
                />
              ))}
            </div>
          </div>
        )}

        <!-- Depoimento Real do Cliente -->
        {story.data.testimonial && (
          <div class="bg-brand-beige/60 p-8 rounded-2xl border border-brand-gold/20 space-y-4">
            <div class="flex text-brand-gold text-lg">★★★★★</div>
            <p class="text-gray-800 italic text-base sm:text-lg leading-relaxed">
              "{story.data.testimonial.quote}"
            </p>
            <p class="text-sm font-bold text-gray-900 pt-1">
              — {story.data.testimonial.author}
            </p>
          </div>
        )}

        <!-- Links Contextuais Estruturados -->
        <div class="bg-brand-beige/30 p-6 sm:p-8 rounded-2xl border border-brand-gold/15 space-y-4">
          <h3 class="text-lg font-bold text-gray-900 font-serif-brand">
            Conheça Mais Sobre este Ensaio
          </h3>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={`/ensaios/${story.data.serviceSlug}/`}
              class="p-4 bg-white rounded-xl border border-gray-100 flex-1 hover:border-brand-gold transition-colors block"
            >
              <p class="text-xs text-brand-gold font-bold uppercase">Serviço Completo</p>
              <p class="font-bold text-gray-900 text-sm pt-1">Ver Detalhes do Ensaio →</p>
            </a>
            <a
              href={`/portfolio/${story.data.portfolioSlug}/`}
              class="p-4 bg-white rounded-xl border border-gray-100 flex-1 hover:border-brand-gold transition-colors block"
            >
              <p class="text-xs text-brand-gold font-bold uppercase">Galeria Visual</p>
              <p class="font-bold text-gray-900 text-sm pt-1">Ver Mais Fotos no Portfólio →</p>
            </a>
          </div>
        </div>

        <WhatsAppCTA
          variant="banner"
          service={story.data.serviceSlug}
          customTitle={`Gostou da sessão da ${story.data.clientName}?`}
          customSubtitle="Fale conosco no WhatsApp para tirar dúvidas e planejar a sua própria sessão de fotos em Tijucas."
        />

      </div>
    </section>
  </article>

  <StudioLocation />
</BaseLayout>
