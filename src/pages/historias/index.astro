---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCollection } from "astro:content";

const title = "Histórias Reais de Ensaios Fotográficos | Estúdio Evydência";
const description = "Veja bastidores, depoimentos e ensaios reais realizados por Anderson e Elaine no Estúdio Evydência em Tijucas - SC.";

const stories = (await getCollection("stories")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Experiência Real (E-E-A-T)
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Histórias de Ensaios Reais no Estúdio Evydência
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Conheça os bastidores, a iluminação escolhida e os relatos de famílias que viveram a experiência do Estúdio Evydência em Tijucas.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {stories.map((story) => (
          <a
            href={`/historias/${story.id}/`}
            class="group block bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between"
          >
            <div>
              <div class="aspect-[16/10] bg-gray-100 overflow-hidden relative">
                <img
                  src={story.data.featuredImage}
                  alt={story.data.title}
                  width="600"
                  height="375"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-gold-dark bg-white/95 backdrop-blur-xs px-3 py-1 rounded-full shadow-xs">
                    {story.data.sessionType}
                  </span>
                </div>
              </div>
              
              <div class="p-6 space-y-2">
                <p class="text-xs text-gray-400 font-semibold">
                  📍 {story.data.location}
                </p>
                <h2 class="text-xl font-bold text-gray-900 font-serif-brand group-hover:text-brand-gold transition-colors leading-snug">
                  {story.data.h1}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed pt-1 line-clamp-2">
                  {story.data.description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-gray-50 mt-4 flex items-center justify-between text-sm font-semibold text-brand-gold">
              <span>Ler história completa</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16">
        <WhatsAppCTA
          variant="banner"
          service="historias"
          customTitle="Quer que a sua história seja a próxima?"
          customSubtitle="Fale com Anderson e Elaine para planejar uma sessão personalizada e acolhedora em Tijucas."
        />
      </div>

    </div>
  </section>
</BaseLayout>
