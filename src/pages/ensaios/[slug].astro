---
import { getCollection, render } from "astro:content";
import ServiceLayout from "@/layouts/ServiceLayout.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services
    .filter((s) => s.data.category !== "eventos")
    .map((service) => ({
      params: { slug: service.id },
      props: { service }
    }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const portfolioMap: Record<string, string> = {
  "gestante-tijucas": "/portfolio/gestante/",
  "familia-tijucas": "/portfolio/familia/",
  "infantil-tijucas": "/portfolio/infantil/",
  "acompanhamento-bebe-tijucas": "/portfolio/infantil/",
  "smash-the-cake-tijucas": "/portfolio/infantil/",
  "corporativo-tijucas": "/portfolio/corporativo/",
  "casal-tijucas": "/portfolio/familia/"
};

const blogMap: Record<string, { href: string; label: string }> = {
  "gestante-tijucas": { href: "/blog/quando-fazer-ensaio-gestante/", label: "Quando Fazer o Ensaio de Gestante (Guia)" },
  "familia-tijucas": { href: "/blog/como-preparar-crianca-primeiro-ensaio/", label: "Como Preparar Crianças para o Ensaio" },
  "infantil-tijucas": { href: "/blog/como-preparar-crianca-primeiro-ensaio/", label: "Dicas de Tranquilidade para a Sessão Infantil" },
  "acompanhamento-bebe-tijucas": { href: "/blog/como-preparar-crianca-primeiro-ensaio/", label: "Dicas de Conforto para o Bebê" },
  "smash-the-cake-tijucas": { href: "/blog/como-preparar-crianca-primeiro-ensaio/", label: "Como Preparar o Bebê para o Smash the Cake" }
};

const portfolioHref = portfolioMap[service.id];
const blogItem = blogMap[service.id];
---

<ServiceLayout
  title={service.data.title}
  description={service.data.description}
  h1={service.data.h1}
  serviceName={service.data.serviceName}
  featuredImage={service.data.featuredImage}
  heroText={service.data.heroText}
  summary={service.data.summary}
  faqs={service.data.faqs}
  portfolioHref={portfolioHref}
  blogHref={blogItem?.href}
  blogLabel={blogItem?.label}
>
  <Content />
</ServiceLayout>
