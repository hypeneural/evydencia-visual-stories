---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCollection } from "astro:content";

const title = "Ensaios Fotográficos em Tijucas SC | Estúdio Evydência";
const description = "Conheça todos os ensaios fotográficos em estúdio e ao ar livre realizados pelo Estúdio Evydência em Tijucas - SC: gestantes, famílias, bebês e retratos.";

const allServices = await getCollection("services");
const studioAndOutdoorServices = allServices
  .filter((s) => s.data.category !== "eventos")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Nossas Especialidades
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Ensaios Fotográficos no Estúdio Evydência
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Sessões pensadas para acolher, respeitar seu tempo e transformar momentos especiais em memórias para a vida toda.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {studioAndOutdoorServices.map((service) => (
          <article class="bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 border border-gray-100 flex flex-col justify-between">
            <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
              <img
                src={service.data.featuredImage}
                alt={service.data.serviceName}
                width="400"
                height="300"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>
            
            <div class="p-6 space-y-3 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">
                  {service.data.serviceType}
                </span>
                <h2 class="text-xl font-bold text-gray-900 font-serif-brand mt-1">
                  {service.data.serviceName}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed mt-2">
                  {service.data.heroText}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-50">
                <a
                  href={`/ensaios/${service.id}/`}
                  class="inline-flex items-center text-sm font-semibold text-brand-gold hover:text-brand-gold-dark hover:underline"
                >
                  Conhecer este ensaio →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16">
        <WhatsAppCTA variant="banner" />
      </div>

    </div>
  </section>
</BaseLayout>
