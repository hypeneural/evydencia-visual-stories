---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCollection } from "astro:content";
import { BUSINESS_DATA } from "@/data/business";

const title = "Estúdio Evydência na Imprensa | Matérias e Reconhecimento";
const description = `Confira notícias, matérias e reportagens sobre o trabalho do Estúdio Evydência ao longo de mais de ${BUSINESS_DATA.yearsOfExperience} anos em Tijucas e Santa Catarina.`;

const allPress = await getCollection("press");
const pressList = allPress.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Mídia & Imprensa
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Notícias e Menções na Mídia Regional
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Reportagens e coberturas jornalísticas reais sobre o trabalho de Anderson, Elaine e o Estúdio Evydência em Tijucas e no litoral de Santa Catarina.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      {pressList.map((item) => (
        <article class="bg-white rounded-2xl p-8 shadow-xs hover:shadow-md transition-shadow border border-gray-100 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-gray-500">
            <span class="font-bold text-brand-gold uppercase tracking-wider">{item.data.outlet}</span>
            <time datetime={item.data.date.toISOString()}>
              {new Intl.DateTimeFormat("pt-BR", { day: "numeric", month: "long", year: "numeric" }).format(item.data.date)}
            </time>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 font-serif-brand">
            {item.data.headline}
          </h2>

          <p class="text-gray-700 leading-relaxed text-sm sm:text-base">
            {item.data.summary}
          </p>

          <div class="pt-2">
            <a
              href={item.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-sm font-bold text-brand-gold hover:text-brand-gold-dark hover:underline gap-1.5"
            >
              <span>Acessar reportagem original no {item.data.outlet}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </article>
      ))}

      <div class="mt-12">
        <WhatsAppCTA variant="banner" />
      </div>

    </div>
  </section>
</BaseLayout>
