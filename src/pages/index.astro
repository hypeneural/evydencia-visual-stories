---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import PressMentions from "@/components/business/PressMentions.astro";
import ScrollSnapSlider from "@/components/ui/ScrollSnapSlider.astro";
import PictureCard from "@/components/gallery/PictureCard.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { BUSINESS_DATA } from "@/data/business";
import { SERVICES_NAVIGATION } from "@/data/navigation";

const title = "Estúdio de Fotos em Tijucas SC | Estúdio Evydência";
const description = `Estúdio de fotografia em Tijucas - SC. Especialistas em ensaios de gestante, família, acompanhamento do bebê, smash the cake e retratos corporativos.`;

const sliderImages = [
  { src: "https://evydencia.com.br/imgs/GESTANTES.png", alt: "Ensaio de Gestante em Estúdio Climatizado em Tijucas", caption: "Ensaio de Gestante" },
  { src: "https://evydencia.com.br/imgs/ACOMPANHAMENO_MENSAL.png", alt: "Acompanhamento Mensal do Primeiro Ano do Bebê", caption: "Acompanhamento do Primeiro Ano" },
  { src: "https://evydencia.com.br/imgs/SMASH_THE_CAKE.png", alt: "Sessão Smash the Cake de Primeiro Aninho com Banho", caption: "Smash the Cake de 1 Aninho" },
  { src: "https://evydencia.com.br/imgs/CORPORATIVO.png", alt: "Retrato Corporativo e Foto de Perfil Profissional", caption: "Retrato Corporativo & Perfil" },
  { src: "https://evydencia.com.br/imgs/BATIZADOS.png", alt: "Cobertura Fotográfica de Batizado em Tijucas", caption: "Cerimônias de Batizado" },
  { src: "https://evydencia.com.br/imgs/ANIVERSARIO.png", alt: "Fotografia de Festa de Aniversário Infantil", caption: "Aniversários em Família" }
];

const serviceDetails: Record<string, string> = {
  "/ensaios/gestante-tijucas/": "Registrar a doce espera com direção acolhedora, conforto absoluto e valorização da beleza materna.",
  "/ensaios/familia-tijucas/": "Criar retratos autênticos de afeto, cumplicidade e conexão entre as diferentes gerações da família.",
  "/ensaios/infantil-tijucas/": "Fotografar a espontaneidade, as descobertas e a alegria das crianças em um ambiente lúdico e seguro.",
  "/ensaios/acompanhamento-bebe-tijucas/": "Documentar a evolução e cada detalhe do primeiro ano de vida com respeito ao ritmo do bebê.",
  "/ensaios/smash-the-cake-tijucas/": "Celebrar o primeiro aniversário com diversão, brincadeiras com o bolo e banho quentinho no final.",
  "/ensaios/casal-tijucas/": "Eternizar o amor, o carinho e a sintonia do casal em estúdio ou em cenários ao ar livre.",
  "/ensaios/corporativo-tijucas/": "Construir posicionamento, autoridade e confiança visual para sua carreira, escritório ou negócio."
};

const verifiedReviews = [
  {
    name: "Mariana Souza",
    role: "Mãe do Theo",
    source: "Avaliação no Google Maps",
    text: "O ensaio de gestante e o acompanhamento do meu filho foram perfeitos! A paciência e o carinho do Anderson e da Elaine com os bebês é algo incrível. O estúdio é impecável e super acolhedor."
  },
  {
    name: "Carlos Eduardo",
    role: "Advogado",
    source: "Avaliação no Google Maps",
    text: "Fiz minhas fotos de perfil profissional no Estúdio Evydência e o resultado superou todas as expectativas. Iluminação impecável e direção de poses que me deixou super confiante."
  },
  {
    name: "Patrícia e Rodrigo",
    role: "Família",
    source: "Avaliação no Google Maps",
    text: "Já fizemos ensaios com a Evydência ao longo dos anos. Eles fazem parte da história da nossa família em Tijucas. Recomendamos de olhos fechados!"
  }
];
---

<BaseLayout title={title} description={description} showBreadcrumbs={false}>
  
  <!-- Hero Principal da Home -->
  <section class="relative bg-gradient-to-b from-brand-beige via-brand-beige/50 to-white py-16 lg:py-24 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto space-y-6">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-brand-gold/15 text-brand-gold-dark text-xs sm:text-sm font-semibold rounded-full uppercase tracking-wider">
          ⭐ Estúdio Evydência • Desde {BUSINESS_DATA.foundingYear} em Tijucas SC
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight font-serif-brand">
          Estúdio de Fotos em Tijucas SC
        </h1>

        <p class="text-lg sm:text-xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
          O <strong>Estúdio Evydência</strong> é um estúdio de fotografia profissional em Tijucas, Santa Catarina, fundado por Anderson e Elaine, especializado em registrar famílias, gestantes, acompanhamento de bebês e retratos corporativos com sensibilidade, técnica e conforto.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={BUSINESS_DATA.links.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-gold hover:bg-brand-gold-dark text-white font-bold text-base rounded-full shadow-md hover:shadow-lg transition-all duration-200 hover-lift focus:outline-hidden focus:ring-2 focus:ring-brand-gold"
          >
            Agendar Ensaio pelo WhatsApp
          </a>
          <a
            href="#ensaios"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-gray-50 text-gray-800 font-semibold text-base border border-gray-200 rounded-full shadow-2xs transition-colors focus:outline-hidden focus:ring-2 focus:ring-brand-gold"
          >
            Conhecer Nossos Ensaios
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Slider de Fotos Destaque (Scroll Snap Nativo + Lightbox) -->
  <section class="py-16 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollSnapSlider
        id="home-gallery-slider"
        title="Momentos Reais, Histórias Eternizadas"
        subtitle="Explore alguns dos registros fotográficos capturados pela equipe do Estúdio Evydência."
      >
        {sliderImages.map((img, index) => (
          <div class="scroll-snap-align-start shrink-0 w-[280px] sm:w-[340px]">
            <PictureCard
              src={img.src}
              alt={img.alt}
              caption={img.caption}
              aspectRatio="landscape"
              loading={index < 2 ? "eager" : "lazy"}
              enableZoom={true}
            />
          </div>
        ))}
      </ScrollSnapSlider>
    </div>
  </section>

  <!-- Estatísticas de Autoridade -->
  <section class="bg-brand-gold py-12 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        {BUSINESS_DATA.stats.map((stat) => (
          <div class="space-y-1">
            <p class="text-4xl sm:text-5xl font-bold font-serif-brand">
              {stat.value}{stat.suffix}
            </p>
            <p class="text-base sm:text-lg text-white/90 font-medium">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção de Serviços e Ensaios -->
  <section id="ensaios" class="py-20 bg-brand-beige/40 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold text-brand-gold uppercase tracking-wider bg-white px-3 py-1 rounded-full shadow-2xs border border-brand-gold/10">
          Nossas Especialidades
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 font-serif-brand">
          Ensaios Fotográficos em Tijucas
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Do início da gravidez ao crescimento dos filhos, comemorações e retratos profissionais.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES_NAVIGATION.map((service) => (
          <div class="bg-white rounded-2xl p-7 shadow-xs hover:shadow-md transition-shadow border border-gray-100 flex flex-col justify-between">
            <div class="space-y-3">
              <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">
                {service.category}
              </span>
              <h3 class="text-xl font-bold text-gray-900 font-serif-brand">
                {service.label}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {serviceDetails[service.href] || "Sessões fotográficas personalizadas com direção cuidadosa e ambiente acolhedor."}
              </p>
            </div>
            <div class="pt-6 border-t border-gray-50 mt-6">
              <a
                href={service.href}
                class="inline-flex items-center text-sm font-semibold text-brand-gold hover:text-brand-gold-dark transition-colors"
              >
                Conhecer este ensaio →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quem Somos: Anderson e Elaine (E-E-A-T) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          <div class="rounded-2xl overflow-hidden shadow-md aspect-[3/4] bg-gray-100">
            <img
              src="https://evydencia.com.br/imgs/anderson.jpg"
              alt="Anderson, fotógrafo fundador do Estúdio Evydência"
              width="300"
              height="400"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-md aspect-[3/4] bg-gray-100 mt-6">
            <img
              src="https://evydencia.com.br/imgs/elaine.jpg"
              alt="Elaine, fotógrafa fundadora do Estúdio Evydência"
              width="300"
              height="400"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">
            Desde {BUSINESS_DATA.foundingYear} em Tijucas
          </span>
          
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 font-serif-brand">
            Mais de {BUSINESS_DATA.yearsOfExperience} Anos Registrando Histórias Reais
          </h2>

          <p class="text-gray-700 leading-relaxed text-base sm:text-lg">
            Fundado pelo casal de fotógrafos <strong>Anderson e Elaine</strong>, o Estúdio Evydência nasceu da dedicação em registrar a essência de cada momento e transformar laços familiares em lembranças que atravessam gerações.
          </p>

          <p class="text-gray-600 leading-relaxed">
            Ao longo de nossa trajetória em Tijucas, acompanhamos gestações, os primeiros passos de bebês, aniversários e conquistas profissionais. Nosso compromisso é aliar domínio técnico de iluminação a um ambiente seguro, acolhedor e atencioso.
          </p>

          <div class="pt-2">
            <a
              href="/sobre/"
              class="inline-flex items-center text-base font-semibold text-brand-gold hover:text-brand-gold-dark hover:underline"
            >
              Leia nossa história completa →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Imprensa e Reconhecimento Real -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <PressMentions limit={2} />
  </div>

  <!-- Depoimentos e Avaliações Reais -->
  <section class="py-20 bg-brand-beige/50 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-2">
        <span class="text-xs font-bold text-brand-gold uppercase tracking-wider bg-white px-3 py-1 rounded-full shadow-2xs border border-brand-gold/10">
          Experiências Compartilhadas
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 font-serif-brand">
          O Que Nossos Clientes Dizem
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Depoimentos de famílias e profissionais que realizaram seus ensaios com o Estúdio Evydência.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {verifiedReviews.map((t) => (
          <div class="bg-white rounded-2xl p-8 shadow-xs border border-gray-100 space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="text-amber-400 text-lg">★★★★★</div>
              <p class="text-gray-700 text-sm sm:text-base leading-relaxed italic">
                "{t.text}"
              </p>
            </div>
            <div class="pt-4 border-t border-gray-50 flex items-center justify-between">
              <div>
                <p class="font-bold text-gray-900 text-sm">{t.name}</p>
                <p class="text-xs text-gray-500">{t.role}</p>
              </div>
              <span class="text-2xs text-brand-gold-dark font-medium bg-brand-gold/10 px-2 py-0.5 rounded">
                {t.source}
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href={BUSINESS_DATA.links.googleReviews}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm font-semibold text-brand-gold hover:text-brand-gold-dark hover:underline gap-1.5"
        >
          <span>Consulte todas as avaliações no Google Maps</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="mt-14 text-center">
        <WhatsAppCTA variant="banner" />
      </div>
    </div>
  </section>

  <!-- Localização e Mapa em Tijucas -->
  <StudioLocation />

</BaseLayout>
