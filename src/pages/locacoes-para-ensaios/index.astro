---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";

const title = "Locais para Ensaio Fotográfico no Litoral SC | Estúdio Evydência";
const description = "Guia prático de locações para ensaios externos em Itapema, Porto Belo e Vale do Rio Tijucas, com dicas de luz, vento e horários do Estúdio Evydência.";

const locations = [
  {
    title: "Locais para Ensaio em Itapema SC",
    slug: "itapema",
    description: "Canto da Praia e Meia Praia: mar calmo, píer de pescadores, vegetação costeira e a luz dourada do pôr do sol.",
    image: "https://evydencia.com.br/imgs/GESTANTES.png",
    types: "Gestante • Casal • Família",
    link: "/locacoes-para-ensaios/itapema/"
  },
  {
    title: "Locais para Ensaio em Porto Belo SC",
    slug: "porto-belo",
    description: "Caixa d'Aço e enseadas protegidas: costões de pedra, águas esmeralda e vegetação preservada para fotos intimistas.",
    image: "https://evydencia.com.br/imgs/REVELACAO.png",
    types: "Casal / Pré-Wedding • Gestante",
    link: "/locacoes-para-ensaios/porto-belo/"
  },
  {
    title: "Cenários Campestres no Vale do Rio Tijucas",
    slug: "vale-do-rio-tijucas",
    description: "Campos abertos, estradas rurais de chão batido e clima bucólico a poucos minutos do centro de Tijucas.",
    image: "https://evydencia.com.br/imgs/ANIVERSARIO.png",
    types: "Família • Crianças • Gestante",
    link: "/locacoes-para-ensaios/vale-do-rio-tijucas/"
  }
];
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-beige to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-gold-dark uppercase tracking-wider bg-brand-gold/10 px-3 py-1 rounded-full">
        Guia de Cenários Externos
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
        Onde Fazer Ensaio Fotográfico no Litoral SC
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Compartilhamos nossa experiência prática de mais de 15 anos fotografando famílias, gestantes e casais nas melhores praias e recantos da Costa Esmeralda e Vale do Rio Tijucas.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {locations.map((loc) => (
          <a
            href={loc.link}
            class="group block bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between"
          >
            <div>
              <div class="aspect-[16/11] bg-gray-100 overflow-hidden relative">
                <img
                  src={loc.image}
                  alt={loc.title}
                  width="400"
                  height="275"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-gold-dark bg-white/95 backdrop-blur-xs px-2.5 py-1 rounded-full shadow-xs">
                    {loc.types}
                  </span>
                </div>
              </div>

              <div class="p-6 space-y-2">
                <h2 class="text-xl font-bold text-gray-900 font-serif-brand group-hover:text-brand-gold transition-colors leading-snug">
                  {loc.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed pt-1">
                  {loc.description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-gray-50 mt-4 flex items-center justify-between text-sm font-semibold text-brand-gold">
              <span>Ler guia da locação</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16">
        <WhatsAppCTA
          variant="banner"
          service="locacoes_externas"
          customTitle="Deseja fotografar em alguma dessas locações?"
          customSubtitle="Fale conosco para definir a melhor época, horários de luz suave e looks para sua sessão externa."
          customMessage="Olá! Gostaria de informações sobre ensaios externos em locações da região com o Estúdio Evydência."
        />
      </div>

    </div>
  </section>

  <StudioLocation />
</BaseLayout>
