---
import BaseLayout from "./BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { CANONICAL_IDS } from "@/lib/seo/schema";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string | undefined;
  featuredImage: string;
  tags?: string[];
  readingTime?: string;
}

const {
  title,
  description,
  pubDate,
  featuredImage,
  tags = [],
  readingTime = "5 min"
} = Astro.props;

const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const formattedDate = new Intl.DateTimeFormat("pt-BR", {
  day: "numeric",
  month: "long",
  year: "numeric"
}).format(pubDate);

const articleGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": CANONICAL_IDS.website
      },
      "about": {
        "@id": `${canonicalUrl}#article`
      },
      "inLanguage": "pt-BR"
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      "headline": title,
      "description": description,
      "image": featuredImage,
      "datePublished": pubDate.toISOString(),
      "author": {
        "@id": CANONICAL_IDS.anderson
      },
      "publisher": {
        "@id": CANONICAL_IDS.business
      },
      "mainEntityOfPage": canonicalUrl
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://evydencia.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://evydencia.com.br/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  image={featuredImage}
  type="article"
  schema={articleGraph}
>
  <article class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabeçalho do Artigo com Autoria Transparente -->
      <header class="text-center space-y-4 mb-8">
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-brand-gold-dark uppercase tracking-wider">
          {tags.map((tag) => (
            <span class="bg-brand-beige px-3 py-1 rounded-full">{tag}</span>
          ))}
          <span class="text-gray-400">•</span>
          <span class="text-gray-500 font-normal">{readingTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand leading-tight">
          {title}
        </h1>

        <div class="bg-brand-beige/50 p-4 rounded-xl border border-brand-gold/15 max-w-xl mx-auto text-xs sm:text-sm text-gray-700 space-y-1">
          <p>
            ✍️ <strong>Escrito por Anderson</strong> (Fotógrafo e Fundador do Estúdio Evydência)
          </p>
          <p>
            🔍 <strong>Revisado por Elaine</strong> (Fotógrafa e Fundadora) • <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          </p>
        </div>
      </header>

      <!-- Imagem de Destaque -->
      <div class="rounded-2xl overflow-hidden shadow-md mb-10 aspect-[16/9] bg-gray-100">
        <img
          src={featuredImage}
          alt={title}
          width="900"
          height="506"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Corpo do Post -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <slot />
      </div>

      <!-- Banner de Conversão -->
      <div class="mt-12">
        <WhatsAppCTA
          variant="banner"
          service="blog_post"
          customTitle="Gostou das dicas e quer planejar seu ensaio?"
          customSubtitle="Fale com Anderson e Elaine no WhatsApp para tirar dúvidas e agendar sua sessão em Tijucas."
        />
      </div>

    </div>
  </article>
</BaseLayout>
