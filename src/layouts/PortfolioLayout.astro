---
import BaseLayout from "./BaseLayout.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import PictureCard from "@/components/gallery/PictureCard.astro";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { CANONICAL_IDS } from "@/lib/seo/schema";

interface GalleryImageItem {
  src: string;
  alt: string;
  caption?: string | undefined;
}

interface Props {
  title: string;
  description: string;
  category: string;
  gallery: GalleryImageItem[];
}

const { title, description, category, gallery } = Astro.props;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);

const portfolioGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": CANONICAL_IDS.website
      },
      "about": {
        "@id": CANONICAL_IDS.business
      },
      "inLanguage": "pt-BR"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://evydencia.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Portfólio",
          "item": "https://evydencia.com.br/portfolio/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={portfolioGraph}>
  <section class="bg-gradient-to-b from-brand-beige via-brand-beige/40 to-white py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-gold/15 text-brand-gold-dark text-xs sm:text-sm font-semibold rounded-full uppercase tracking-wider">
        Portfólio Fotográfico • {category.toUpperCase()}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 font-serif-brand">
        {title}
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {description}
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Grade de Imagens de Portfólio com PictureCard e Lightbox Nativo -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {gallery.map((img, index) => (
          <PictureCard
            src={img.src}
            alt={img.alt}
            caption={img.caption}
            aspectRatio="square"
            loading={index < 3 ? "eager" : "lazy"}
            enableZoom={true}
          />
        ))}
      </div>

      <div class="my-14 prose max-w-3xl mx-auto text-gray-700 leading-relaxed text-center">
        <slot />
      </div>

      <!-- Links Cruzados Contextuais -->
      <div class="my-12 p-8 bg-brand-beige/40 rounded-2xl border border-brand-gold/20 max-w-4xl mx-auto text-center space-y-4">
        <h3 class="text-xl font-bold text-gray-900 font-serif-brand">
          Quer planejar o seu ensaio?
        </h3>
        <p class="text-sm text-gray-600 max-w-xl mx-auto">
          Confira os detalhes sobre como funcionam as sessões, tire suas dúvidas nos guias do blog ou veja histórias reais fotografadas por Anderson e Elaine.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a
            href="/ensaios/"
            class="px-5 py-2.5 bg-brand-gold text-white font-semibold text-sm rounded-full shadow-xs hover:bg-brand-gold-dark transition-colors"
          >
            Ver Detalhes dos Ensaios →
          </a>
          <a
            href="/historias/"
            class="px-5 py-2.5 bg-white text-gray-800 border border-gray-200 font-semibold text-sm rounded-full hover:bg-gray-50 transition-colors"
          >
            Conhecer Histórias Reais →
          </a>
          <a
            href="/blog/"
            class="px-5 py-2.5 bg-white text-gray-800 border border-gray-200 font-semibold text-sm rounded-full hover:bg-gray-50 transition-colors"
          >
            Dicas & Guias no Blog →
          </a>
        </div>
      </div>

      <WhatsAppCTA
        variant="banner"
        service="portfolio"
        customTitle="Gostou do nosso portfólio?"
        customSubtitle="Fale conosco no WhatsApp para consultar datas disponíveis e receber uma proposta personalizada para sua sessão."
      />
    </div>
  </section>
</BaseLayout>
