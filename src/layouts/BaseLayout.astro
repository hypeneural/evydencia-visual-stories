---
import SEOHead from "@/components/seo/SEOHead.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import AnnouncementBar from "@/components/ui/AnnouncementBar.astro";
import LightboxDialog from "@/components/gallery/LightboxDialog.astro";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { buildLocalBusinessGraph } from "@/lib/seo/schema";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  noindex?: boolean | undefined;
  schema?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  showBreadcrumbs?: boolean | undefined;
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  schema,
  showBreadcrumbs = true
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = getCanonicalUrl(pathname);
const defaultGraph = buildLocalBusinessGraph(canonicalUrl, title, description);
const finalSchema = schema || defaultGraph;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <SEOHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    image={image}
    type={type}
    noindex={noindex}
  />
  
  <body class="min-h-screen flex flex-col bg-white text-gray-900 font-sans antialiased selection:bg-brand-gold/20 selection:text-brand-dark">
    <!-- Acessibilidade: Skip Link para conteúdo principal -->
    <a href="#conteudo-principal" class="skip-link">
      Pular para o conteúdo principal
    </a>

    <!-- Barra de Anúncios Sazonal (Campanha de Natal 2026) -->
    <AnnouncementBar />

    <!-- Grafo de Entidade Canônico Schema.org -->
    <JsonLd schema={finalSchema} />

    <Header currentPath={pathname} />

    {showBreadcrumbs && pathname !== "/" && (
      <div class="bg-gray-50 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <Breadcrumbs pathname={pathname} />
        </div>
      </div>
    )}

    <main id="conteudo-principal" class="flex-1">
      <slot />
    </main>

    <Footer />
    
    <!-- Lightbox Modal Global para Galerias -->
    <LightboxDialog />
  </body>
</html>
