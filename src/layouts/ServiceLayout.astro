---
import BaseLayout from "./BaseLayout.astro";
import FAQAccordion from "@/components/ui/FAQAccordion.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import { buildServiceSchema, buildFAQSchema } from "@/lib/seo/schema";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { BUSINESS_DATA } from "@/data/business";
import { SERVICES_NAVIGATION } from "@/data/navigation";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  serviceName: string;
  featuredImage: string;
  heroText: string;
  summary: string;
  faqs?: FAQItem[];
  portfolioHref?: string | undefined;
  blogHref?: string | undefined;
  blogLabel?: string | undefined;
}

const {
  title,
  description,
  h1,
  serviceName,
  featuredImage,
  heroText,
  summary,
  faqs = [],
  portfolioHref,
  blogHref,
  blogLabel
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = getCanonicalUrl(currentPath);
const serviceSchema = buildServiceSchema(serviceName, description, canonicalUrl, featuredImage);
const faqSchema = faqs.length > 0 ? buildFAQSchema(faqs) : null;
const combinedSchema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;

// Filtrar outros serviços para cross-linking
const otherServices = SERVICES_NAVIGATION.filter(s => s.href !== currentPath).slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  image={featuredImage}
  schema={combinedSchema}
>
  <!-- Hero da Página de Serviço -->
  <section class="bg-gradient-to-b from-brand-beige to-white py-12 lg:py-16 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-gold/10 text-brand-gold-dark text-xs sm:text-sm font-semibold rounded-full uppercase tracking-wider">
            📍 Estúdio Evydência • Tijucas - SC
          </div>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight font-serif-brand">
            {h1}
          </h1>
          
          <p class="text-lg text-gray-600 leading-relaxed">
            {heroText}
          </p>

          <div class="pt-2 flex flex-col sm:flex-row gap-4">
            <a
              href={BUSINESS_DATA.links.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-gold hover:bg-brand-gold-dark text-white font-semibold rounded-full shadow-md hover:shadow-lg transition-all hover-lift"
            >
              Agendar {serviceName} no WhatsApp
            </a>
            <a
              href="#conteudo"
              class="inline-flex items-center justify-center px-6 py-3.5 bg-white hover:bg-gray-50 text-gray-700 font-semibold border border-gray-200 rounded-full transition-colors"
            >
              Ver Detalhes do Ensaio
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100 aspect-[4/3] bg-gray-100 relative group">
            <img
              src={featuredImage}
              alt={`${serviceName} no Estúdio Evydência em Tijucas`}
              width="600"
              height="450"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Resumo da Experiência (Quick Answer) -->
  <section id="conteudo" class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="bg-brand-beige/50 border-l-4 border-brand-gold p-6 rounded-r-xl">
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-serif-brand">
          A Experiência no Estúdio Evydência
        </h2>
        <p class="text-gray-700 leading-relaxed text-sm sm:text-base">
          {summary}
        </p>
      </div>

      <!-- Conteúdo Editorial Markdown -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <slot />
      </div>

      <!-- Bloco de Links Relacionados e Portfólio (Internal Linking Estruturado) -->
      <div class="bg-brand-beige/30 rounded-2xl p-6 sm:p-8 border border-brand-gold/15 space-y-6">
        <h3 class="text-xl font-bold text-gray-900 font-serif-brand">
          Explore Mais e Prepare-se para seu Ensaio
        </h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {portfolioHref && (
            <a
              href={portfolioHref}
              class="p-4 bg-white rounded-xl border border-gray-100 shadow-2xs hover:border-brand-gold/40 hover:shadow-xs transition-all flex flex-col justify-between"
            >
              <div>
                <p class="text-xs font-bold text-brand-gold uppercase tracking-wider">Portfólio Visual</p>
                <p class="font-bold text-gray-900 text-sm sm:text-base pt-1 font-serif-brand">Ver Fotos Destaque deste Ensaio</p>
              </div>
              <span class="text-xs font-semibold text-brand-gold pt-3">Acessar galeria completa →</span>
            </a>
          )}

          {blogHref && (
            <a
              href={blogHref}
              class="p-4 bg-white rounded-xl border border-gray-100 shadow-2xs hover:border-brand-gold/40 hover:shadow-xs transition-all flex flex-col justify-between"
            >
              <div>
                <p class="text-xs font-bold text-brand-gold uppercase tracking-wider">Guia & Dicas</p>
                <p class="font-bold text-gray-900 text-sm sm:text-base pt-1 font-serif-brand">{blogLabel || "Ler Dicas para seu Ensaio"}</p>
              </div>
              <span class="text-xs font-semibold text-brand-gold pt-3">Ler artigo no blog →</span>
            </a>
          )}

          <a
            href="/estudio/"
            class="p-4 bg-white rounded-xl border border-gray-100 shadow-2xs hover:border-brand-gold/40 hover:shadow-xs transition-all flex flex-col justify-between"
          >
            <div>
              <p class="text-xs font-bold text-brand-gold uppercase tracking-wider">Espaço Físico</p>
              <p class="font-bold text-gray-900 text-sm sm:text-base pt-1 font-serif-brand">Conhecer a Estrutura em Tijucas</p>
            </div>
            <span class="text-xs font-semibold text-brand-gold pt-3">Ver bastidores e conforto →</span>
          </a>

          <a
            href="/regiao-de-atendimento/"
            class="p-4 bg-white rounded-xl border border-gray-100 shadow-2xs hover:border-brand-gold/40 hover:shadow-xs transition-all flex flex-col justify-between"
          >
            <div>
              <p class="text-xs font-bold text-brand-gold uppercase tracking-wider">Cobertura Regional</p>
              <p class="font-bold text-gray-900 text-sm sm:text-base pt-1 font-serif-brand">Atendimento a Cidades Vizinhas</p>
            </div>
            <span class="text-xs font-semibold text-brand-gold pt-3">Ver cidades atendidas →</span>
          </a>
        </div>

        <!-- Cross-linking de Serviços Complementares -->
        <div class="pt-4 border-t border-brand-gold/10">
          <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mb-3">Outros Ensaios em Tijucas:</p>
          <div class="flex flex-wrap gap-2">
            {otherServices.map((service) => (
              <a
                href={service.href}
                class="px-3 py-1.5 bg-white hover:bg-brand-gold hover:text-white border border-gray-200 text-xs font-medium rounded-lg transition-colors text-gray-700"
              >
                {service.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- FAQs -->
      {faqs.length > 0 && (
        <FAQAccordion faqs={faqs} title={`Dúvidas Frequentes sobre ${serviceName}`} />
      )}

      <!-- Banner de Conversão WhatsApp -->
      <WhatsAppCTA variant="banner" />
    </div>
  </section>

  <!-- Localização do Estúdio -->
  <StudioLocation />
</BaseLayout>
