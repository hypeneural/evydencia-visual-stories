---
import BaseLayout from "./BaseLayout.astro";
import FAQAccordion from "@/components/ui/FAQAccordion.astro";
import WhatsAppCTA from "@/components/ui/WhatsAppCTA.astro";
import StudioLocation from "@/components/business/StudioLocation.astro";
import { buildServiceSchema, buildFAQSchema } from "@/lib/seo/schema";
import { getCanonicalUrl } from "@/lib/seo/canonical";
import { BUSINESS_DATA } from "@/data/business";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  serviceName: string;
  featuredImage: string;
  heroText: string;
  summary: string;
  faqs?: FAQItem[];
  relatedServices?: string[];
}

const {
  title,
  description,
  h1,
  serviceName,
  featuredImage,
  heroText,
  summary,
  faqs = []
} = Astro.props;

const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const serviceSchema = buildServiceSchema(serviceName, description, canonicalUrl, featuredImage);
const faqSchema = faqs.length > 0 ? buildFAQSchema(faqs) : null;
const combinedSchema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;
---

<BaseLayout
  title={title}
  description={description}
  image={featuredImage}
  schema={combinedSchema}
>
  <!-- Hero da Página de Serviço -->
  <section class="bg-gradient-to-b from-brand-beige to-white py-12 lg:py-16 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-gold/10 text-brand-gold-dark text-xs sm:text-sm font-semibold rounded-full uppercase tracking-wider">
            📍 Estúdio Evydência • Tijucas - SC
          </div>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight font-serif-brand">
            {h1}
          </h1>
          
          <p class="text-lg text-gray-600 leading-relaxed">
            {heroText}
          </p>

          <div class="pt-2 flex flex-col sm:flex-row gap-4">
            <a
              href={BUSINESS_DATA.links.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-gold hover:bg-brand-gold-dark text-white font-semibold rounded-full shadow-md hover:shadow-lg transition-all hover-lift"
            >
              Agendar Ensaio pelo WhatsApp
            </a>
            <a
              href="#conteudo"
              class="inline-flex items-center justify-center px-6 py-3.5 bg-white hover:bg-gray-50 text-gray-700 font-semibold border border-gray-200 rounded-full transition-colors"
            >
              Ver Detalhes e Dúvidas
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100 aspect-[4/3] bg-gray-100 relative group">
            <img
              src={featuredImage}
              alt={`${serviceName} no Estúdio Evydência em Tijucas`}
              width="600"
              height="450"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Resumo da Experiência (Quick Answer) -->
  <section id="conteudo" class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-beige/40 border-l-4 border-brand-gold p-6 rounded-r-xl my-6">
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-serif-brand">
          A Experiência no Estúdio Evydência
        </h2>
        <p class="text-gray-700 leading-relaxed text-sm sm:text-base">
          {summary}
        </p>
      </div>

      <!-- Conteúdo Editorial Markdown -->
      <div class="prose prose-lg max-w-none text-gray-700 my-8 leading-relaxed">
        <slot />
      </div>

      <!-- FAQs -->
      {faqs.length > 0 && (
        <FAQAccordion faqs={faqs} title={`Dúvidas Frequentes sobre ${serviceName}`} />
      )}

      <!-- Banner de Conversão WhatsApp -->
      <WhatsAppCTA variant="banner" />
    </div>
  </section>

  <!-- Localização do Estúdio -->
  <StudioLocation />
</BaseLayout>
