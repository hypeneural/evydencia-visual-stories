---
import { MAIN_NAVIGATION } from "@/data/navigation";

interface Props {
  currentPath?: string | undefined;
  class?: string | undefined;
}

const { currentPath = "/", class: className = "" } = Astro.props;
---

<nav class={`flex items-center gap-1 xl:gap-1.5 ${className}`} aria-label="Navegação Principal">
  {MAIN_NAVIGATION.map((link) => {
    const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
    return (
      <a
        href={link.href}
        class={`px-3 py-1.5 text-xs xl:text-sm font-medium rounded-full transition-all ${
          link.highlight
            ? "text-brand-gold-dark bg-brand-gold/15 border border-brand-gold/30 font-bold hover:bg-brand-gold/25"
            : isActive 
              ? "text-brand-gold font-semibold bg-brand-beige" 
              : "text-gray-700 hover:text-brand-gold hover:bg-brand-beige"
        }`}
        aria-current={isActive ? "page" : undefined}
      >
        {link.label}
      </a>
    );
  })}
</nav>
