---
import { BUSINESS_DATA } from "@/data/business";
import { FOOTER_NAVIGATION } from "@/data/navigation";

const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-gray-300 border-t border-neutral-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Grid Desktop (Visível em sm e acima) -->
    <div class="hidden sm:grid grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Coluna 1: Sobre & Logo -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label="Estúdio Evydência">
          <img 
            src={BUSINESS_DATA.logoWhiteUrl} 
            alt="Estúdio Evydência" 
            width="180" 
            height="48"
            class="h-12 w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-gray-400 leading-relaxed">
          {BUSINESS_DATA.slogan}. Desde {BUSINESS_DATA.foundingYear} transformando momentos em memórias eternas.
        </p>
        
        <div class="pt-1">
          <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Fotógrafos Fundadores</p>
          <p class="text-sm text-gray-300">Anderson e Elaine</p>
        </div>

        <!-- Redes Sociais Oficiais -->
        <div class="pt-2 flex items-center gap-3">
          <a
            href={BUSINESS_DATA.links.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-semibold rounded-lg text-brand-gold-light hover:text-white transition-colors"
            aria-label="Instagram Oficial Estúdio Evydência"
          >
            <span>Instagram</span>
          </a>
          <a
            href={BUSINESS_DATA.links.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-semibold rounded-lg text-gray-300 hover:text-white transition-colors"
            aria-label="Facebook Oficial Estúdio Evydência"
          >
            <span>Facebook</span>
          </a>
        </div>
      </div>

      <!-- Coluna 2: Ensaios Fotográficos -->
      <div>
        <h3 class="text-base font-semibold text-white tracking-wide uppercase mb-4">Ensaios</h3>
        <ul class="space-y-2.5">
          {FOOTER_NAVIGATION.ensaios.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="text-sm text-gray-400 hover:text-brand-gold-light transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 3: Eventos, Institucional & Região -->
      <div>
        <h3 class="text-base font-semibold text-white tracking-wide uppercase mb-4">Institucional</h3>
        <ul class="space-y-2.5">
          {FOOTER_NAVIGATION.institucional.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="text-sm text-gray-400 hover:text-brand-gold-light transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
          {FOOTER_NAVIGATION.eventos.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="text-sm text-gray-400 hover:text-brand-gold-light transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a 
              href="/regiao-de-atendimento/" 
              class="text-sm text-brand-gold hover:text-brand-gold-light transition-colors font-medium"
            >
              Região de Atendimento
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 4: NAP & Atendimento -->
      <div class="space-y-4">
        <h3 class="text-base font-semibold text-white tracking-wide uppercase mb-4">Contato & Estúdio</h3>
        
        <div class="text-sm text-gray-400 space-y-2">
          <p class="flex items-start gap-2">
            <svg class="w-5 h-5 text-brand-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{BUSINESS_DATA.address.formatted}</span>
          </p>

          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${BUSINESS_DATA.telephoneE164}`} class="hover:text-white transition-colors">
              {BUSINESS_DATA.telephone}
            </a>
          </p>

          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${BUSINESS_DATA.email}`} class="hover:text-white transition-colors">
              {BUSINESS_DATA.email}
            </a>
          </p>
        </div>

        <div class="pt-2 text-xs text-gray-400 space-y-1">
          <p class="font-semibold text-gray-300">Horários de Atendimento:</p>
          <p>Seg a Sex: 09h às 12h e 14h às 18h</p>
          <p>Sábados: Mediante agendamento</p>
        </div>

        <div class="flex flex-wrap gap-2 pt-2">
          <a 
            href={BUSINESS_DATA.links.googleMaps} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-medium rounded-md text-gray-300 hover:text-white transition-colors"
          >
            Google Maps
          </a>
          <a 
            href={BUSINESS_DATA.links.googleReviews} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-medium rounded-md text-brand-gold-light hover:text-white transition-colors"
          >
            Avaliações no Google ⭐
          </a>
        </div>
      </div>

    </div>

    <!-- Layout Mobile Inteligente com Accordions <details> (Apenas em telas pequenas) -->
    <div class="sm:hidden space-y-6">
      
      <!-- Cabeçalho Mobile com Logo e Slogan -->
      <div class="space-y-3 text-center">
        <a href="/" class="inline-block" aria-label="Estúdio Evydência">
          <img 
            src={BUSINESS_DATA.logoWhiteUrl} 
            alt="Estúdio Evydência" 
            width="160" 
            height="42"
            class="h-10 w-auto object-contain mx-auto"
            loading="lazy"
          />
        </a>
        <p class="text-xs text-gray-400">
          {BUSINESS_DATA.slogan} • Desde {BUSINESS_DATA.foundingYear} em Tijucas
        </p>
      </div>

      <!-- Detalhes Expansíveis de Links para Mobile -->
      <div class="space-y-2 border-t border-neutral-800 pt-4">
        
        <details class="group bg-neutral-800/40 rounded-xl border border-neutral-800">
          <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-white text-sm select-none list-none">
            <span>Ensaios Fotográficos</span>
            <span class="text-brand-gold transition-transform group-open:rotate-180">▾</span>
          </summary>
          <div class="px-4 pb-4 space-y-2 border-t border-neutral-800/60 pt-3">
            {FOOTER_NAVIGATION.ensaios.map((item) => (
              <a href={item.href} class="block text-sm text-gray-400 hover:text-brand-gold-light py-1">
                {item.label}
              </a>
            ))}
          </div>
        </details>

        <details class="group bg-neutral-800/40 rounded-xl border border-neutral-800">
          <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-white text-sm select-none list-none">
            <span>Institucional & Região</span>
            <span class="text-brand-gold transition-transform group-open:rotate-180">▾</span>
          </summary>
          <div class="px-4 pb-4 space-y-2 border-t border-neutral-800/60 pt-3">
            {FOOTER_NAVIGATION.institucional.map((item) => (
              <a href={item.href} class="block text-sm text-gray-400 hover:text-brand-gold-light py-1">
                {item.label}
              </a>
            ))}
            {FOOTER_NAVIGATION.eventos.map((item) => (
              <a href={item.href} class="block text-sm text-gray-400 hover:text-brand-gold-light py-1">
                {item.label}
              </a>
            ))}
            <a href="/regiao-de-atendimento/" class="block text-sm text-brand-gold hover:text-brand-gold-light py-1 font-medium">
              Região de Atendimento
            </a>
          </div>
        </details>

        <details class="group bg-neutral-800/40 rounded-xl border border-neutral-800">
          <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-white text-sm select-none list-none">
            <span>Contato & Horários</span>
            <span class="text-brand-gold transition-transform group-open:rotate-180">▾</span>
          </summary>
          <div class="px-4 pb-4 space-y-3 border-t border-neutral-800/60 pt-3 text-xs text-gray-400">
            <p>📍 {BUSINESS_DATA.address.formatted}</p>
            <p>📞 <a href={`tel:${BUSINESS_DATA.telephoneE164}`} class="text-brand-gold hover:underline">{BUSINESS_DATA.telephone}</a></p>
            <p>🕒 Seg a Sex: 09h-12h / 14h-18h</p>
            <div class="pt-2 flex gap-2">
              <a href={BUSINESS_DATA.links.googleMaps} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-neutral-700 text-white rounded-lg text-xs">Maps</a>
              <a href={BUSINESS_DATA.links.googleReviews} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-neutral-700 text-brand-gold-light rounded-lg text-xs">Reviews ⭐</a>
            </div>
          </div>
        </details>

      </div>

      <!-- Redes Sociais no Mobile -->
      <div class="flex items-center justify-center gap-3 pt-2">
        <a
          href={BUSINESS_DATA.links.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-neutral-800 text-xs font-semibold rounded-lg text-brand-gold-light"
        >
          Instagram Oficial
        </a>
        <a
          href={BUSINESS_DATA.links.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-neutral-800 text-xs font-semibold rounded-lg text-gray-300"
        >
          Facebook
        </a>
      </div>

    </div>

    <!-- Linha Inferior de Direitos Autorais -->
    <div class="border-t border-neutral-800 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4 text-center sm:text-left">
      <p>© {currentYear} {BUSINESS_DATA.name}. Todos os direitos reservados.</p>
      <p>Estúdio de Fotografia Profissional em Tijucas - SC (CEP {BUSINESS_DATA.address.postalCode})</p>
    </div>
  </div>
</footer>
