---
import { BUSINESS_DATA } from "@/data/business";
import { MAIN_NAVIGATION } from "@/data/navigation";
import Navigation from "./Navigation.astro";

interface Props {
  currentPath?: string | undefined;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo do Estúdio -->
      <a href="/" class="flex items-center gap-3 group focus:outline-hidden focus:ring-2 focus:ring-brand-gold rounded-lg p-1" aria-label="Estúdio Evydência - Página Inicial">
        <img 
          src={BUSINESS_DATA.logoUrl} 
          alt="Estúdio Evydência - Fotografia em Tijucas" 
          width="180" 
          height="48"
          class="h-12 w-auto object-contain transition-transform group-hover:scale-102"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Menu Desktop -->
      <Navigation currentPath={currentPath} class="hidden lg:flex" />

      <!-- CTA WhatsApp Desktop -->
      <div class="hidden sm:flex items-center gap-4">
        <a 
          href={BUSINESS_DATA.links.whatsapp} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[48px] px-6 py-2.5 text-sm font-semibold text-white bg-brand-gold hover:bg-brand-gold-dark rounded-full shadow-xs hover:shadow-md transition-all hover-lift focus:outline-hidden focus:ring-2 focus:ring-brand-gold"
        >
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Agendar Ensaio
        </a>
      </div>

      <!-- Botão Menu Mobile Acessível (>= 48x48px) -->
      <button 
        type="button" 
        id="mobile-menu-button"
        class="lg:hidden p-3 min-w-[48px] min-h-[48px] flex items-center justify-center rounded-xl text-gray-700 hover:text-brand-gold hover:bg-gray-100 focus:outline-hidden focus:ring-2 focus:ring-brand-gold"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir Menu de Navegação"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Menu Dropdown Mobile -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-6 space-y-1 shadow-lg"
    aria-hidden="true"
  >
    <div class="space-y-1">
      {MAIN_NAVIGATION.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-4 py-3 min-h-[48px] text-base font-medium rounded-xl flex items-center ${
              link.highlight
                ? "text-brand-gold-dark bg-brand-gold/15 border border-brand-gold/30 font-bold"
                : isActive 
                  ? "text-brand-gold bg-brand-beige font-semibold" 
                  : "text-gray-700 hover:text-brand-gold hover:bg-gray-50"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </div>
    <div class="pt-4">
      <a 
        href={BUSINESS_DATA.links.whatsapp} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center w-full min-h-[48px] px-4 py-3 text-base font-semibold text-white bg-brand-gold hover:bg-brand-gold-dark rounded-xl shadow-xs"
      >
        Conversar no WhatsApp
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      btn.setAttribute('aria-expanded', String(nextState));
      menu.setAttribute('aria-hidden', String(!nextState));
      menu.classList.toggle('hidden', !nextState);
    });

    // Fechar ao pressionar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        btn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        menu.classList.add('hidden');
        btn.focus();
      }
    });
  }
</script>
