---
import { BUSINESS_DATA } from "@/data/business";
---

<section class="py-12 bg-white rounded-2xl shadow-xs border border-gray-100 p-6 sm:p-10 my-8">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand mb-2">
        Nossa Localização em Tijucas - SC
      </h2>
      <p class="text-gray-600 text-sm sm:text-base">
        Localizado estrategicamente no bairro Universitário, com fácil acesso e estacionamento tranquilo.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
      <div class="lg:col-span-1 space-y-4">
        <div class="p-5 bg-brand-beige rounded-xl border border-brand-gold/10">
          <p class="font-semibold text-gray-900 text-sm mb-1">Endereço:</p>
          <p class="text-sm text-gray-700 leading-relaxed mb-4">
            {BUSINESS_DATA.address.street}<br />
            Bairro {BUSINESS_DATA.address.neighborhood}<br />
            {BUSINESS_DATA.address.city} - {BUSINESS_DATA.address.state}<br />
            CEP {BUSINESS_DATA.address.postalCode}
          </p>

          <div class="flex flex-col gap-2.5">
            <a 
              href={BUSINESS_DATA.links.googleMaps}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-white hover:bg-gray-50 border border-gray-200 rounded-lg text-sm font-semibold text-gray-800 shadow-2xs transition-colors"
            >
              📍 Abrir no Google Maps
            </a>
            <a 
              href={BUSINESS_DATA.links.waze}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-white hover:bg-gray-50 border border-gray-200 rounded-lg text-sm font-semibold text-gray-800 shadow-2xs transition-colors"
            >
              🚗 Navegar com Waze
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2 rounded-xl overflow-hidden shadow-sm border border-gray-200 aspect-[16/9] min-h-[300px]">
        <iframe
          src={BUSINESS_DATA.links.googleMapsEmbed}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa do Estúdio Evydência em Tijucas SC"
          class="w-full h-full min-h-[300px]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
