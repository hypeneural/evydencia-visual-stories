---
import { BUSINESS_DATA } from "@/data/business";
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-6">
  <div class="border-b border-gray-100 pb-4">
    <h3 class="text-xl font-bold text-gray-900 font-serif-brand">
      {BUSINESS_DATA.name}
    </h3>
    <p class="text-sm text-gray-500">{BUSINESS_DATA.slogan}</p>
  </div>

  <div class="space-y-4 text-sm text-gray-700">
    <div class="flex items-start gap-3">
      <span class="text-brand-gold font-bold shrink-0">📍 Endereço:</span>
      <span>{BUSINESS_DATA.address.formatted}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-brand-gold font-bold shrink-0">📞 Telefone / WhatsApp:</span>
      <a href={`tel:${BUSINESS_DATA.telephoneE164}`} class="hover:underline font-medium text-gray-900">
        {BUSINESS_DATA.telephone}
      </a>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-brand-gold font-bold shrink-0">✉️ E-mail:</span>
      <a href={`mailto:${BUSINESS_DATA.email}`} class="hover:underline text-gray-900">
        {BUSINESS_DATA.email}
      </a>
    </div>

    <div class="pt-2 border-t border-gray-100">
      <p class="font-semibold text-gray-900 mb-1">Horário de Funcionamento:</p>
      {BUSINESS_DATA.openingHours.map((h) => (
        <p class="text-gray-600">
          <strong class="text-gray-700">{h.days.join(", ")}:</strong> {h.hours}
        </p>
      ))}
      <p class="text-xs text-gray-400 mt-1">* Ensaios aos domingos e feriados mediante agendamento prévio.</p>
    </div>
  </div>
</div>
