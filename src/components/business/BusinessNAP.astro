---
import { BUSINESS_DATA } from "@/data/business";

interface Props {
  class?: string | undefined;
  showIcon?: boolean | undefined;
}

const {
  class: className = "",
  showIcon = true
} = Astro.props;
---

<address class={`not-italic text-sm text-gray-600 leading-relaxed ${className}`}>
  {showIcon && <span class="mr-1">📍</span>}
  <span class="font-semibold text-gray-900">{BUSINESS_DATA.name}</span> • 
  <span>{BUSINESS_DATA.address.street}, {BUSINESS_DATA.address.neighborhood}</span> • 
  <span>{BUSINESS_DATA.address.city} - {BUSINESS_DATA.address.state}</span> • 
  <span class="font-medium">CEP {BUSINESS_DATA.address.postalCode}</span>
</address>
