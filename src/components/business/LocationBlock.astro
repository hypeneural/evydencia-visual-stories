---
import { BUSINESS_DATA } from "@/data/business";
import BusinessNAP from "./BusinessNAP.astro";
import BusinessHours from "./BusinessHours.astro";

interface Props {
  title?: string | undefined;
  subtitle?: string | undefined;
  class?: string | undefined;
}

const {
  title = "Localização do Estúdio",
  subtitle = "Nosso estúdio está localizado no bairro Universitário em Tijucas - SC, com fácil acesso e estacionamento em frente.",
  class: className = ""
} = Astro.props;
---

<div class={`bg-brand-beige/50 p-6 sm:p-8 rounded-2xl border border-brand-gold/20 space-y-6 ${className}`}>
  <div class="space-y-1">
    <h3 class="text-xl font-bold text-gray-900 font-serif-brand">
      {title}
    </h3>
    <p class="text-gray-600 text-sm leading-relaxed">
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
    <div class="space-y-3">
      <h4 class="font-bold text-gray-900 text-sm uppercase tracking-wider text-brand-gold-dark">
        Endereço Físico
      </h4>
      <BusinessNAP />
      <div class="pt-1">
        <a
          href={BUSINESS_DATA.links.googleMaps}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-gold hover:text-brand-gold-dark hover:underline"
        >
          <span>Abrir no Google Maps →</span>
        </a>
      </div>
    </div>

    <div class="space-y-3">
      <h4 class="font-bold text-gray-900 text-sm uppercase tracking-wider text-brand-gold-dark">
        Atendimento
      </h4>
      <BusinessHours />
    </div>
  </div>
</div>
