---
import { getCollection } from "astro:content";

interface Props {
  storySlugs?: string[] | undefined;
  serviceCategory?: string | undefined;
  title?: string | undefined;
}

const {
  storySlugs = [],
  serviceCategory,
  title = "História Real no Estúdio Evydência"
} = Astro.props;

const allStories = await getCollection("stories");
const relatedStories = allStories.filter(s => {
  if (storySlugs.length > 0) {
    return storySlugs.includes(s.id);
  }
  if (serviceCategory) {
    return s.data.category.toLowerCase() === serviceCategory.toLowerCase();
  }
  return true;
}).slice(0, 2);
---

{relatedStories.length > 0 && (
  <section class="my-12 p-6 sm:p-8 bg-brand-beige/40 rounded-2xl border border-brand-gold/20 space-y-6">
    <div class="text-center space-y-1">
      <span class="text-xs font-bold text-brand-gold uppercase tracking-wider bg-white px-3 py-0.5 rounded-full border border-brand-gold/10">
        Experiência Real Documentada
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
        {title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      {relatedStories.map((story) => (
        <article class="bg-white p-6 rounded-xl border border-gray-100 shadow-2xs space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="aspect-[16/9] rounded-lg overflow-hidden bg-gray-100">
              <img
                src={story.data.coverImage}
                alt={story.data.title}
                width="600"
                height="338"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <h3 class="text-lg font-bold text-gray-900 font-serif-brand">
              {story.data.title}
            </h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed italic">
              "{story.data.testimonial.quote}"
            </p>
            <p class="text-2xs font-semibold text-gray-400">
              — {story.data.testimonial.author} ({story.data.testimonial.role})
            </p>
          </div>

          <div class="pt-3 border-t border-gray-50">
            <a
              href={`/historias/${story.id}/`}
              class="inline-flex items-center text-xs font-bold text-brand-gold hover:text-brand-gold-dark gap-1"
            >
              <span>Ver relato completo e fotos da sessão</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
