---
import { getCollection } from "astro:content";

interface Props {
  articleSlugs?: string[] | undefined;
  tag?: string | undefined;
  title?: string | undefined;
}

const {
  articleSlugs = [],
  tag,
  title = "Dicas e Orientações no Blog"
} = Astro.props;

const allPosts = await getCollection("blog");
const relatedPosts = allPosts.filter(p => {
  if (articleSlugs.length > 0) {
    return articleSlugs.includes(p.id);
  }
  if (tag) {
    return p.data.tags?.some(t => t.toLowerCase() === tag.toLowerCase());
  }
  return true;
}).slice(0, 2);
---

{relatedPosts.length > 0 && (
  <section class="my-12 space-y-6">
    <div class="text-center space-y-1">
      <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">
        Conteúdo Editorial
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-serif-brand">
        {title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      {relatedPosts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="group block bg-white p-6 rounded-2xl border border-gray-100 shadow-2xs hover:border-brand-gold/30 hover:shadow-md transition-all space-y-3"
        >
          <div class="aspect-[16/9] rounded-lg overflow-hidden bg-gray-100">
            <img
              src={post.data.featuredImage}
              alt={post.data.title}
              width="600"
              height="338"
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <span class="text-2xs font-bold text-brand-gold uppercase tracking-wider">
            {post.data.readingTime}
          </span>
          <h3 class="text-base font-bold text-gray-900 font-serif-brand group-hover:text-brand-gold transition-colors">
            {post.data.title}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed line-clamp-2">
            {post.data.description}
          </p>
          <span class="inline-flex items-center text-xs font-bold text-brand-gold pt-1">
            Ler artigo completo →
          </span>
        </a>
      ))}
    </div>
  </section>
)}
