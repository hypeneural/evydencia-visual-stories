---
import { BUSINESS_DATA } from "@/data/business";

interface Props {
  variant?: "floating" | "banner" | "button";
  message?: string;
  className?: string;
  customTitle?: string | undefined;
  customSubtitle?: string | undefined;
  customMessage?: string | undefined;
  service?: string | undefined;
  position?: string | undefined;
}

const { 
  variant = "floating", 
  message = "Agende seu Ensaio", 
  className = "",
  customTitle,
  customSubtitle,
  customMessage,
  service = "geral",
  position = "footer"
} = Astro.props;

const phoneDigits = BUSINESS_DATA.telephoneE164.replace(/\D/g, "");
const defaultText = "Olá! Gostaria de mais informações sobre os ensaios do Estúdio Evydência.";
const textToEncode = customMessage || defaultText;
const customUrl = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(textToEncode)}`;

const bannerTitle = customTitle || "Pronto para eternizar momentos inesquecíveis?";
const bannerSubtitle = customSubtitle || "Entre em contato conosco pelo WhatsApp para tirar dúvidas sobre datas, pacotes e disponibilidade em Tijucas.";
---

{variant === "floating" && (
  <a
    href={customUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-40 flex items-center gap-2.5 bg-[#25D366] hover:bg-[#20ba59] text-white px-5 py-3.5 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 group whatsapp-track"
    data-whatsapp-service={service}
    data-whatsapp-position="floating"
    aria-label="Falar conosco no WhatsApp"
  >
    <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="font-semibold text-sm sm:text-base tracking-wide">
      {message}
    </span>
  </a>
)}

{variant === "banner" && (
  <div class={`bg-brand-beige border border-brand-gold/20 rounded-2xl p-8 text-center my-12 ${className}`}>
    <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3 font-serif-brand">
      {bannerTitle}
    </h3>
    <p class="text-gray-600 max-w-2xl mx-auto mb-6 text-base sm:text-lg leading-relaxed">
      {bannerSubtitle}
    </p>
    <a
      href={customUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 bg-brand-gold hover:bg-brand-gold-dark text-white font-semibold text-base px-8 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-200 hover-lift whatsapp-track"
      data-whatsapp-service={service}
      data-whatsapp-position={position || "banner"}
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Conversar com a Equipe no WhatsApp
    </a>
  </div>
)}

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.whatsapp-track').forEach((btn) => {
      btn.addEventListener('click', () => {
        const service = btn.getAttribute('data-whatsapp-service') || 'geral';
        const position = btn.getAttribute('data-whatsapp-position') || 'unknown';
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'whatsapp_click', {
            service_name: service,
            click_position: position,
            page_path: window.location.pathname
          });
        }
        if (Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'whatsapp_click',
            service_name: service,
            click_position: position,
            page_path: window.location.pathname
          });
        }
      });
    });
  });
</script>
