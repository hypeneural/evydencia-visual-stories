---
---

<dialog
  id="global-lightbox"
  class="fixed inset-0 m-auto p-4 sm:p-6 bg-transparent border-0 max-w-5xl w-full max-h-[95vh] focus:outline-hidden z-50"
  aria-label="Visualizador de Imagem Ampliada"
>
  <div class="relative bg-neutral-900/95 text-white rounded-2xl overflow-hidden shadow-2xl border border-white/10 flex flex-col max-h-[90vh]">
    
    <!-- Barra superior com botão fechar -->
    <div class="flex items-center justify-between p-4 border-b border-white/10">
      <p id="lightbox-caption" class="text-sm font-medium text-gray-200 truncate pr-4">Visualização de Imagem</p>
      <button
        type="button"
        id="lightbox-close"
        class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white transition-colors focus:outline-hidden focus:ring-2 focus:ring-brand-gold shrink-0"
        aria-label="Fechar visualizador de imagem"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Imagem em destaque -->
    <div class="p-2 sm:p-4 flex items-center justify-center grow overflow-hidden">
      <img
        id="lightbox-image"
        data-lightbox-modal="true"
        src="https://evydencia.com.br/bio/logoPreta.png"
        alt="Imagem ampliada do Estúdio Evydência"
        width="800"
        height="600"
        class="max-h-[75vh] w-auto max-w-full object-contain rounded-lg"
      />
    </div>

  </div>
</dialog>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('global-lightbox');
    const closeBtn = document.getElementById('lightbox-close');
    const imgEl = document.getElementById('lightbox-image');
    const captionEl = document.getElementById('lightbox-caption');

    if (!dialog || !closeBtn || !imgEl || !captionEl) return;

    // Fechar ao clicar no botão fechar
    closeBtn.addEventListener('click', () => dialog.close());

    // Fechar ao clicar no backdrop escuro
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });

    // Abrir ao clicar em qualquer botão com classe .lightbox-trigger
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.lightbox-trigger');
      if (trigger) {
        e.preventDefault();
        const src = trigger.getAttribute('data-img-src') || '';
        const alt = trigger.getAttribute('data-img-alt') || '';
        const caption = trigger.getAttribute('data-img-caption') || alt;

        imgEl.src = src;
        imgEl.alt = alt;
        captionEl.textContent = caption;

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      }
    });
  });
</script>
