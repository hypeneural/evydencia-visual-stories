---
interface Props {
  src: string;
  alt: string;
  caption?: string | undefined;
  aspectRatio?: "square" | "portrait" | "landscape" | "video" | undefined;
  loading?: "eager" | "lazy" | undefined;
  enableZoom?: boolean | undefined;
  class?: string | undefined;
}

const {
  src,
  alt,
  caption,
  aspectRatio = "square",
  loading = "lazy",
  enableZoom = true,
  class: className = ""
} = Astro.props;

const aspectClasses = {
  square: "aspect-square",
  portrait: "aspect-[3/4]",
  landscape: "aspect-[4/3]",
  video: "aspect-[16/9]"
};
---

<figure class={`group relative rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 border border-gray-100 bg-gray-50 ${className}`}>
  <div class={`overflow-hidden w-full ${aspectClasses[aspectRatio]}`}>
    <img
      src={src}
      alt={alt}
      width="600"
      height="600"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading={loading}
      decoding="async"
    />
  </div>

  {enableZoom && (
    <button
      type="button"
      class="lightbox-trigger absolute inset-0 w-full h-full bg-black/0 hover:bg-black/20 focus:bg-black/20 focus:outline-hidden focus:ring-2 focus:ring-brand-gold transition-colors flex items-center justify-center cursor-zoom-in"
      data-img-src={src}
      data-img-alt={alt}
      data-img-caption={caption || alt}
      aria-label={`Ampliar imagem: ${alt}`}
    >
      <span class="opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity bg-black/60 text-white text-xs font-semibold px-3 py-1.5 rounded-full backdrop-blur-xs flex items-center gap-1.5 shadow-md">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
        </svg>
        Ampliar
      </span>
    </button>
  )}

  {caption && (
    <figcaption class="p-3 text-xs text-gray-600 bg-white border-t border-gray-100 text-center">
      {caption}
    </figcaption>
  )}
</figure>
