<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Forçar domínio sem WWW
  RewriteCond %{HTTP_HOST} ^www\.evydencia\.com\.br [NC]
  RewriteRule ^(.*)$ https://evydencia.com.br/$1 [L,R=301]

  # 3. Redirecionamento de sitemaps legados
  RewriteRule ^wp-sitemap.*\.xml$ https://evydencia.com.br/sitemap-index.xml [L,R=301]
  RewriteRule ^sitemap\.xml$ https://evydencia.com.br/sitemap-index.xml [L,R=301]

  # 4. Redirecionamento de rotas legadas
  RewriteRule ^gestantes/?$ https://evydencia.com.br/ensaios/gestante-tijucas/ [L,R=301]
  RewriteRule ^familia/?$ https://evydencia.com.br/ensaios/familia-tijucas/ [L,R=301]
  RewriteRule ^infantil/?$ https://evydencia.com.br/ensaios/infantil-tijucas/ [L,R=301]
  RewriteRule ^corporativo/?$ https://evydencia.com.br/ensaios/corporativo-tijucas/ [L,R=301]
  RewriteRule ^galeria/?$ https://evydencia.com.br/portfolio/ [L,R=301]
  RewriteRule ^servicos/?$ https://evydencia.com.br/ensaios/ [L,R=301]

  # 5. Proteger e redirecionar acessos a rotas legadas de WordPress
  RewriteRule ^wp-(content|admin|includes|login\.php).*$ https://evydencia.com.br/ [L,R=301]
</IfModule>

# Cache de Assets Estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
