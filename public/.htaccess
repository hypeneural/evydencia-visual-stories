# ==============================================================================
# ESTÚDIO EVYDÊNCIA - CONFIGURAÇÃO APACHE / PLESK (.htaccess)
# Domínio Canônico: https://evydencia.com.br
# ==============================================================================

RewriteEngine On

# 1. Forçar HTTPS e Domínio Canônico sem WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.evydencia\.com\.br$ [NC]
RewriteRule ^(.*)$ https://evydencia.com.br/$1 [L,R=301]

# 2. Redirecionamentos de Sitemaps Legados para o Sitemap Index
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap-index.xml [L,R=301]

# 3. Compressão Brotli com Fallback Gzip (mod_deflate)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  <IfModule !mod_brotli.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml
  </IfModule>
</IfModule>

# 4. Políticas de Cache Específicas por Tipo de Recurso
<IfModule mod_headers.c>
  # HTML: Revalidação Imediata (Frescor garantido)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Sitemaps e Robots: TTL Curto / Revalidação
  <FilesMatch "(sitemap.*\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Assets Imutáveis com Hash gerados pelo Astro (_astro/)
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens Otimizadas
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # 5. Cabeçalhos de Segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSP em modo Report-Only para monitoramento sem bloquear tracking
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://api.indexnow.org https://wa.me; frame-src 'self' https://www.google.com;"
</IfModule>

# 6. Página de Erro 404 Personalizada
ErrorDocument 404 /404.html
