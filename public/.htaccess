# ==============================================================================
# .htaccess - Estúdio Evydência (evydencia.com.br)
# Otimização de Performance, Redirecionamento Canônico 301 e Segurança
# ==============================================================================

RewriteEngine On

# 1. Redirecionar sitemaps legados do WordPress para o sitemap real do Astro
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap-index.xml [R=301,L]

# 2. Forçar HTTPS e remover WWW (Canonical Host: https://evydencia.com.br/)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.evydencia\.com\.br$ [NC]
RewriteRule ^(.*)$ https://evydencia.com.br/$1 [R=301,L]

# 3. Forçar Trailing Slash em diretórios (evita duplicidade de URLs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://evydencia.com.br/$1/ [R=301,L]

# 4. Configurações de Página de Erro 404 Personalizada
ErrorDocument 404 /404.html

# 5. Compressão GZIP / Brotli
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Cache de Cabeçalhos HTTP para Assets Estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
